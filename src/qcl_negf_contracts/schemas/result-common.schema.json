{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result v2 transport definitions",
  "$defs": {
    "Count": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)(?![\\s\\S])",
      "maxLength": 20
    },
    "PositiveCount": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4][0-9]{0}|18446744073709551615)(?![\\s\\S])",
      "maxLength": 20
    },
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "FileRef": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "$ref": "#/$defs/Count"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256",
        "media_type",
        "schema"
      ],
      "additionalProperties": false
    },
    "Artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "$ref": "#/$defs/Count"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "enum": [
            "science",
            "full-state",
            "both",
            "local"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256",
        "media_type",
        "schema",
        "role",
        "profile",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "Identity": {
      "type": "object",
      "properties": {
        "run_id": {
          "$ref": "#/$defs/Id"
        },
        "execution_id": {
          "$ref": "#/$defs/Id"
        },
        "point_id": {
          "$ref": "#/$defs/Id"
        },
        "attempt": {
          "$ref": "#/$defs/PositiveCount"
        },
        "branch_id": {
          "$ref": "#/$defs/Id"
        },
        "model_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "plan_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      },
      "required": [
        "run_id",
        "execution_id",
        "point_id",
        "attempt",
        "branch_id",
        "model_sha256",
        "plan_sha256"
      ],
      "additionalProperties": false
    },
    "NumericalBinding": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "core-state.schema.json#/$defs/ExactRestartIdentity"
        },
        "execution": {
          "$ref": "core-state.schema.json#/$defs/ExactExecutionIdentity"
        }
      },
      "required": [
        "identity",
        "execution"
      ],
      "additionalProperties": false
    },
    "StateRef": {
      "type": "object",
      "properties": {
        "identity": {
          "$ref": "#/$defs/Identity"
        },
        "state_id": {
          "$ref": "#/$defs/Id"
        },
        "state_sequence": {
          "$ref": "#/$defs/PositiveCount"
        },
        "manifest": {
          "$ref": "#/$defs/FileRef"
        }
      },
      "required": [
        "identity",
        "state_id",
        "state_sequence",
        "manifest"
      ],
      "additionalProperties": false
    },
    "Lineage": {
      "type": "object",
      "properties": {
        "parent_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/StateRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "parent_state"
      ],
      "additionalProperties": false
    },
    "Invocation": {
      "type": "object",
      "properties": {
        "source_epoch": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "source_epoch"
      ],
      "additionalProperties": false
    },
    "HistoryTotals": {
      "type": "object",
      "properties": {
        "records": {
          "$ref": "#/$defs/Count"
        },
        "scba_rows": {
          "$ref": "#/$defs/Count"
        },
        "outer_rows": {
          "$ref": "#/$defs/Count"
        },
        "witness_updates": {
          "$ref": "#/$defs/Count"
        },
        "last_record": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "records",
        "scba_rows",
        "outer_rows",
        "witness_updates",
        "last_record"
      ],
      "additionalProperties": false
    },
    "HistoryPin": {
      "type": "object",
      "properties": {
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/FileRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "entries": {
          "$ref": "#/$defs/Count"
        },
        "records": {
          "$ref": "#/$defs/Count"
        },
        "scba_rows": {
          "$ref": "#/$defs/Count"
        },
        "outer_rows": {
          "$ref": "#/$defs/Count"
        },
        "witness_updates": {
          "$ref": "#/$defs/Count"
        },
        "last_record": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "head",
        "entries",
        "records",
        "scba_rows",
        "outer_rows",
        "witness_updates",
        "last_record"
      ],
      "additionalProperties": false
    },
    "ProcessStatus": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "pending",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted",
            "unknown"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "exit_code",
        "reason"
      ],
      "additionalProperties": false
    },
    "EvidenceStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "const": "recorded"
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "$ref": "#/$defs/FileRef"
            }
          },
          "required": [
            "state",
            "reason",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "not_measured",
                "unsupported",
                "error"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "type": "null"
            }
          },
          "required": [
            "state",
            "reason",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Status": {
      "type": "object",
      "properties": {
        "process": {
          "$ref": "#/$defs/ProcessStatus"
        },
        "convergence": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "physics": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "discretization": {
          "$ref": "#/$defs/EvidenceStatus"
        },
        "experimental": {
          "$ref": "#/$defs/EvidenceStatus"
        }
      },
      "required": [
        "process",
        "convergence",
        "physics",
        "discretization",
        "experimental"
      ],
      "additionalProperties": false
    },
    "RowLocator": {
      "type": "object",
      "properties": {
        "source_identity": {
          "$ref": "#/$defs/Identity"
        },
        "source_epoch": {
          "$ref": "#/$defs/Id"
        },
        "append_ordinal": {
          "$ref": "#/$defs/PositiveCount"
        },
        "leaf": {
          "$ref": "#/$defs/FileRef"
        },
        "row_offset": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "source_identity",
        "source_epoch",
        "append_ordinal",
        "leaf",
        "row_offset"
      ],
      "additionalProperties": false
    },
    "AppendTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "const": "same_leaf"
            },
            "source_identity": {
              "$ref": "#/$defs/Identity"
            },
            "source_epoch": {
              "$ref": "#/$defs/Id"
            },
            "append_ordinal": {
              "$ref": "#/$defs/PositiveCount"
            },
            "leaf": {
              "type": "null"
            },
            "row_offset": {
              "$ref": "#/$defs/Count"
            },
            "anchor_state": {
              "type": "null"
            },
            "anchor_history": {
              "type": "null"
            }
          },
          "required": [
            "scope",
            "source_identity",
            "source_epoch",
            "append_ordinal",
            "leaf",
            "row_offset",
            "anchor_state",
            "anchor_history"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "const": "sealed_leaf"
            },
            "source_identity": {
              "$ref": "#/$defs/Identity"
            },
            "source_epoch": {
              "$ref": "#/$defs/Id"
            },
            "append_ordinal": {
              "$ref": "#/$defs/PositiveCount"
            },
            "leaf": {
              "$ref": "#/$defs/FileRef"
            },
            "row_offset": {
              "$ref": "#/$defs/Count"
            },
            "anchor_state": {
              "type": "null"
            },
            "anchor_history": {
              "type": "null"
            }
          },
          "required": [
            "scope",
            "source_identity",
            "source_epoch",
            "append_ordinal",
            "leaf",
            "row_offset",
            "anchor_state",
            "anchor_history"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "const": "parent_checkpoint"
            },
            "source_identity": {
              "$ref": "#/$defs/Identity"
            },
            "source_epoch": {
              "$ref": "#/$defs/Id"
            },
            "append_ordinal": {
              "$ref": "#/$defs/PositiveCount"
            },
            "leaf": {
              "$ref": "#/$defs/FileRef"
            },
            "row_offset": {
              "$ref": "#/$defs/Count"
            },
            "anchor_state": {
              "$ref": "#/$defs/StateRef"
            },
            "anchor_history": {
              "$ref": "#/$defs/HistoryPin"
            }
          },
          "required": [
            "scope",
            "source_identity",
            "source_epoch",
            "append_ordinal",
            "leaf",
            "row_offset",
            "anchor_state",
            "anchor_history"
          ],
          "additionalProperties": false
        }
      ]
    },
    "WitnessTarget": {
      "type": "object",
      "properties": {
        "row_key": {
          "$ref": "core-state.schema.json#/$defs/ScientificRowKey"
        },
        "locator": {
          "$ref": "#/$defs/RowLocator"
        }
      },
      "required": [
        "row_key",
        "locator"
      ],
      "additionalProperties": false
    }
  }
}
