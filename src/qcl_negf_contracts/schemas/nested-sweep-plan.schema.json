{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
    },
    "root": {
      "$ref": "#/$defs/Node"
    }
  },
  "required": [
    "name",
    "root"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Existing finite nested sweep tree; original YAML bytes remain authoritative",
  "$defs": {
    "PortableValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortableValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PortableValue"
          }
        }
      ]
    },
    "Node": {
      "oneOf": [
        {
          "$ref": "#/$defs/Leaf"
        },
        {
          "$ref": "#/$defs/Level"
        }
      ]
    },
    "Leaf": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "leaf"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "Level": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "level"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Axis"
          }
        },
        "child": {
          "$ref": "#/$defs/Node"
        }
      },
      "required": [
        "kind",
        "name",
        "axes",
        "child"
      ],
      "additionalProperties": false
    },
    "Axis": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/PortableValue"
          }
        }
      },
      "required": [
        "name",
        "values"
      ],
      "additionalProperties": false
    }
  }
}
