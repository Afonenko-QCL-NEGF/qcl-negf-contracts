{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate optional technical telemetry envelopes; no scientific acceptance",
  "oneOf": [
    {
      "$ref": "#/$defs/TelemetryCommit"
    },
    {
      "$ref": "#/$defs/TelemetryPointer"
    },
    {
      "$ref": "#/$defs/TelemetrySummary"
    },
    {
      "$ref": "#/$defs/TelemetrySourceBinding"
    },
    {
      "$ref": "#/$defs/TelemetryBinding"
    }
  ],
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "Label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "Path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "F64": {
      "type": "number",
      "minimum": -1.7976931348623157e+308,
      "maximum": 1.7976931348623157e+308
    },
    "Seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.7976931348623157e+308
    },
    "TransportAttempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "CatalogEntries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "CommitRef": {
      "allOf": [
        {
          "$ref": "result-common.schema.json#/$defs/FileRef"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "qcl-negf.telemetry-commit.v1"
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "schema",
            "media_type"
          ]
        }
      ]
    },
    "SummaryRef": {
      "allOf": [
        {
          "$ref": "result-common.schema.json#/$defs/FileRef"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "qcl-negf.telemetry-summary.v1"
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "schema",
            "media_type"
          ]
        }
      ]
    },
    "SourceBindingRef": {
      "allOf": [
        {
          "$ref": "result-common.schema.json#/$defs/FileRef"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "qcl-negf.telemetry-source-binding.v1"
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "schema",
            "media_type"
          ]
        }
      ]
    },
    "PublicationRef": {
      "allOf": [
        {
          "$ref": "result-common.schema.json#/$defs/FileRef"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "qcl-negf.producer-phase-publication.v1"
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "schema",
            "media_type"
          ]
        }
      ]
    },
    "SegmentRef": {
      "allOf": [
        {
          "$ref": "result-common.schema.json#/$defs/FileRef"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "qcl-negf.producer-phase-segment.v1"
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "schema",
            "media_type"
          ]
        }
      ]
    },
    "PlanRef": {
      "allOf": [
        {
          "$ref": "result-common.schema.json#/$defs/FileRef"
        },
        {
          "type": "object",
          "properties": {
            "schema": {
              "const": "qcl-negf-scientific-plan-v2"
            },
            "media_type": {
              "const": "application/json"
            }
          },
          "required": [
            "schema",
            "media_type"
          ]
        }
      ]
    },
    "CollectorSession": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "producer-phase-source.schema.json#/$defs/Source"
        },
        "allocation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "allocation_id"
      ],
      "additionalProperties": false
    },
    "TransportSelection": {
      "type": "object",
      "properties": {
        "calcjob_uuid": {
          "$ref": "#/$defs/Text"
        },
        "execution_id": {
          "$ref": "#/$defs/Text"
        },
        "attempt": {
          "$ref": "#/$defs/TransportAttempt"
        },
        "plan_fingerprint": {
          "$ref": "result-common.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "calcjob_uuid",
        "execution_id",
        "attempt",
        "plan_fingerprint"
      ],
      "additionalProperties": false
    },
    "Transport": {
      "type": "object",
      "properties": {
        "selection": {
          "$ref": "#/$defs/TransportSelection"
        },
        "frozen_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "selection",
        "frozen_plan"
      ],
      "additionalProperties": false
    },
    "CatalogPin": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/Path"
        },
        "entries": {
          "$ref": "#/$defs/CatalogEntries"
        },
        "sha256": {
          "$ref": "result-common.schema.json#/$defs/Sha256"
        }
      },
      "required": [
        "path",
        "entries",
        "sha256"
      ],
      "additionalProperties": false
    },
    "Baseline": {
      "type": "object",
      "properties": {
        "commit": {
          "$ref": "#/$defs/CommitRef"
        },
        "summary": {
          "$ref": "#/$defs/SummaryRef"
        }
      },
      "required": [
        "commit",
        "summary"
      ],
      "additionalProperties": false
    },
    "BindingStatus": {
      "enum": [
        "bound",
        "unbound"
      ]
    },
    "StateBinding": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/BindingStatus"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "result-common.schema.json#/$defs/StateRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "invocation": {
          "anyOf": [
            {
              "$ref": "result-common.schema.json#/$defs/Invocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceBindingRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "state",
        "invocation",
        "evidence",
        "reason"
      ],
      "additionalProperties": false
    },
    "SourceCursor": {
      "type": "object",
      "properties": {
        "source_key": {
          "$ref": "result-common.schema.json#/$defs/Sha256"
        },
        "identity": {
          "$ref": "result-common.schema.json#/$defs/Identity"
        },
        "source": {
          "$ref": "producer-phase-source.schema.json#/$defs/Source"
        },
        "cursor": {
          "$ref": "producer-phase-source.schema.json#/$defs/Cursor"
        },
        "route_epoch": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "binding": {
          "$ref": "#/$defs/StateBinding"
        },
        "producer_health": {
          "anyOf": [
            {
              "$ref": "producer-phase-source.schema.json#/$defs/Health"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_closed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "health_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_key",
        "identity",
        "source",
        "cursor",
        "route_epoch",
        "binding",
        "producer_health",
        "source_closed",
        "health_reason"
      ],
      "additionalProperties": false
    },
    "Mode": {
      "enum": [
        "normal",
        "diagnostic"
      ]
    },
    "AcceptedRange": {
      "type": "object",
      "properties": {
        "source_key": {
          "$ref": "result-common.schema.json#/$defs/Sha256"
        },
        "publication": {
          "$ref": "#/$defs/PublicationRef"
        },
        "segment": {
          "$ref": "#/$defs/SegmentRef"
        },
        "retained_publication": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicationRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_segment": {
          "anyOf": [
            {
              "$ref": "#/$defs/SegmentRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "first_row": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "stop_row": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "cursor": {
          "$ref": "producer-phase-source.schema.json#/$defs/Cursor"
        }
      },
      "required": [
        "source_key",
        "publication",
        "segment",
        "retained_publication",
        "retained_segment",
        "mode",
        "first_row",
        "stop_row",
        "cursor"
      ],
      "additionalProperties": false
    },
    "TableCounts": {
      "type": "object",
      "properties": {
        "spans": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "resources": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "control_events": {
          "$ref": "result-common.schema.json#/$defs/Count"
        }
      },
      "required": [
        "spans",
        "resources",
        "control_events"
      ],
      "additionalProperties": false
    },
    "Totals": {
      "type": "object",
      "properties": {
        "rows": {
          "$ref": "#/$defs/TableCounts"
        },
        "accepted_source_rows": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "accepted_aggregate_calls": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "accepted_diagnostic_events": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "coalesced_source_events": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "collector_dropped_rows": {
          "$ref": "result-common.schema.json#/$defs/Count"
        }
      },
      "required": [
        "rows",
        "accepted_source_rows",
        "accepted_aggregate_calls",
        "accepted_diagnostic_events",
        "coalesced_source_events",
        "collector_dropped_rows"
      ],
      "additionalProperties": false
    },
    "MeasurementStatus": {
      "enum": [
        "measured",
        "not_measured",
        "error"
      ]
    },
    "ForecastStatus": {
      "enum": [
        "forecast",
        "unavailable"
      ]
    },
    "MeasureSeconds": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/MeasurementStatus"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "MeasureCount": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "result-common.schema.json#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/MeasurementStatus"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "ForecastCount": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "result-common.schema.json#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/ForecastStatus"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "value",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "CpuTotals": {
      "type": "object",
      "properties": {
        "cpu_seconds": {
          "$ref": "#/$defs/MeasureSeconds"
        },
        "allocated_cpu_seconds": {
          "$ref": "#/$defs/MeasureSeconds"
        },
        "observed_capacity_cpu_seconds": {
          "$ref": "#/$defs/MeasureSeconds"
        },
        "covered_wall_seconds": {
          "$ref": "#/$defs/Seconds"
        },
        "valid_intervals": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "missing_samples": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "discontinuous_intervals": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "incomplete": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Text"
          },
          "maxItems": 32
        },
        "scope": {
          "const": "sum_of_accepted_disjoint_baseline_intervals_per_allocation"
        },
        "intervals_overlap_across_allocations": {
          "const": true
        }
      },
      "required": [
        "cpu_seconds",
        "allocated_cpu_seconds",
        "observed_capacity_cpu_seconds",
        "covered_wall_seconds",
        "valid_intervals",
        "missing_samples",
        "discontinuous_intervals",
        "incomplete",
        "reasons",
        "scope",
        "intervals_overlap_across_allocations"
      ],
      "additionalProperties": false
    },
    "CpuAllocation": {
      "type": "object",
      "properties": {
        "allocation_id": {
          "$ref": "#/$defs/Text"
        },
        "execution_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "samples": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "valid_intervals": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "missing_samples": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "discontinuous_intervals": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "covered_wall_seconds": {
          "$ref": "#/$defs/Seconds"
        },
        "cpu_seconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "allocated_cpu_seconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_capacity_cpu_seconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "coarse_intervals": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "coarse_wall_seconds": {
          "$ref": "#/$defs/Seconds"
        },
        "fine_resolution_wall_seconds": {
          "$ref": "#/$defs/Seconds"
        },
        "maximum_observed_interval_seconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_sample_monotonic_ns": {
          "anyOf": [
            {
              "$ref": "result-common.schema.json#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_sample_monotonic_ns": {
          "anyOf": [
            {
              "$ref": "result-common.schema.json#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_window_seconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seconds"
            },
            {
              "type": "null"
            }
          ]
        },
        "fraction_of_observed_window_covered": {
          "anyOf": [
            {
              "$ref": "#/$defs/F64"
            },
            {
              "type": "null"
            }
          ]
        },
        "mean_busy_logical_cpus": {
          "anyOf": [
            {
              "$ref": "#/$defs/F64"
            },
            {
              "type": "null"
            }
          ]
        },
        "fraction_of_allocated_cpu": {
          "anyOf": [
            {
              "$ref": "#/$defs/F64"
            },
            {
              "type": "null"
            }
          ]
        },
        "fraction_of_observed_capacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/F64"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpu_unavailable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        },
        "capacity_unavailable_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "allocation_id",
        "execution_id",
        "samples",
        "valid_intervals",
        "missing_samples",
        "discontinuous_intervals",
        "covered_wall_seconds",
        "cpu_seconds",
        "allocated_cpu_seconds",
        "observed_capacity_cpu_seconds",
        "coarse_intervals",
        "coarse_wall_seconds",
        "fine_resolution_wall_seconds",
        "maximum_observed_interval_seconds",
        "first_sample_monotonic_ns",
        "last_sample_monotonic_ns",
        "observed_window_seconds",
        "fraction_of_observed_window_covered",
        "mean_busy_logical_cpus",
        "fraction_of_allocated_cpu",
        "fraction_of_observed_capacity",
        "cpu_unavailable_reason",
        "capacity_unavailable_reason"
      ],
      "additionalProperties": false
    },
    "CpuCoverage": {
      "type": "object",
      "properties": {
        "allocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CpuAllocation"
          },
          "maxItems": 16
        },
        "unidentified_samples": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "profile_samples_excluded": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "temporal_resolution_target_seconds": {
          "$ref": "#/$defs/Seconds"
        },
        "schema": {
          "const": "qcl-negf.cpu-coverage.v2"
        },
        "maximum_interval_seconds": {
          "const": null
        },
        "missing_is_zero": {
          "const": false
        },
        "intervals_overlap_across_allocations": {
          "const": true
        },
        "scope": {
          "const": "baseline process-group CPU deltas / allocated logical CPU time; not host utilization"
        },
        "long_interval_policy": {
          "const": "retain stable counter deltas as coarse interval averages"
        },
        "phase_attribution": {
          "const": "not inferred from resource endpoints; use producer phase counters"
        },
        "observed_capacity_scope": {
          "const": "minimum of allocation width and observed node quota; ancestor quotas may be unavailable"
        }
      },
      "required": [
        "allocations",
        "unidentified_samples",
        "profile_samples_excluded",
        "temporal_resolution_target_seconds",
        "schema",
        "maximum_interval_seconds",
        "missing_is_zero",
        "intervals_overlap_across_allocations",
        "scope",
        "long_interval_policy",
        "phase_attribution",
        "observed_capacity_scope"
      ],
      "additionalProperties": false
    },
    "TimingKind": {
      "enum": [
        "inclusive",
        "exclusive"
      ]
    },
    "MeasurementKind": {
      "enum": [
        "phase_duration",
        "interval",
        "delay",
        "phase_boundary"
      ]
    },
    "Representation": {
      "enum": [
        "normal_aggregate",
        "diagnostic_end_projection"
      ]
    },
    "SpanAggregate": {
      "type": "object",
      "properties": {
        "phase": {
          "$ref": "#/$defs/Label"
        },
        "timing_kind": {
          "$ref": "#/$defs/TimingKind"
        },
        "measurement_kind": {
          "$ref": "#/$defs/MeasurementKind"
        },
        "call_count": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "duration_seconds": {
          "$ref": "#/$defs/MeasureSeconds"
        },
        "warmup_calls": {
          "$ref": "result-common.schema.json#/$defs/Count"
        },
        "warmup_seconds": {
          "$ref": "#/$defs/MeasureSeconds"
        },
        "maximum_seconds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seconds"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "phase",
        "timing_kind",
        "measurement_kind",
        "call_count",
        "duration_seconds",
        "warmup_calls",
        "warmup_seconds",
