{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Snapshot metadata v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "stage",
    "iteration",
    "quality",
    "warnings",
    "status",
    "units",
    "sampling"
  ],
  "properties": {
    "schema": {
      "const": "qcl-negf-physics-snapshot-metadata-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "stage": {
      "type": "string"
    },
    "iteration": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "quality": {
      "enum": [
        "strict",
        "approximate",
        "unconverged",
        "invalid"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status": {
      "type": "string"
    },
    "units": {
      "type": "object"
    },
    "sampling": {
      "type": "object",
      "required": [
        "method",
        "original_shape",
        "stored_shape"
      ]
    }
  },
  "additionalProperties": false
}
