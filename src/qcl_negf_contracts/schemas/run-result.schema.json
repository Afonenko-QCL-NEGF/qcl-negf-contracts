{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QCL-NEGF persisted run result v1",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "status",
    "point_count",
    "counts"
  ],
  "properties": {
    "schema": {
      "const": "qcl-run-result-v1"
    },
    "run_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "point_count": {
      "type": "integer",
      "minimum": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
